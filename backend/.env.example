# Copia a .env y ajusta en la VPS del BACKEND
JWT_SECRET=cambia-este-secreto-en-produccion-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
# Origen publico del frontend (dominio HTTPS). Ejemplo:
FRONTEND_ORIGIN=https://tu-dominio.com
MAX_LOGIN_ATTEMPTS=5
BLOCK_SECONDS=600
# API conecta con rol `pos`: solo EXECUTE en stored procedures
DATABASE_URL=postgresql+psycopg2://pos:pos123@db:5432/posdb
FIRST_PURCHASE_DISCOUNT=0.15
# Superusuario solo para crear el esquema (compose db + db-init)
POSTGRES_PASSWORD=postgres
# Imagenes en disco (no en DB): cuota total y max por archivo
IMAGE_DIR=./uploads
IMAGE_QUOTA_MB=50
MAX_IMAGE_MB=2
