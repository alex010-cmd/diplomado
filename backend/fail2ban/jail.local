[DEFAULT]
# Bloqueo temporal de IP tras intentos fallidos de login
bantime = 600
findtime = 600
maxretry = 5

[backend-fastapi]
enabled = true
# Ajusta al puerto real del backend y al log de uvicorn/docker
port = 8000
filter = backend-fastapi
logpath = /var/log/backend/uvicorn.log
maxretry = 5
bantime = 600
findtime = 600
banaction = iptables-multiport
