# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Puerto HTTP
PORT=3000

# Ruta de la base de datos SQLite (relativa a la raiz del proyecto)
DATABASE_PATH=./backend/data/app.db

# Secretos JWT (cambiar SIEMPRE en produccion, minimo 32 caracteres aleatorios)
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-por-uno-aleatorio-largo
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh-por-otro-aleatorio-largo

# TTL de los tokens (notacion ms/vercel: "15m", "7d", etc.)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Coste de bcrypt (12 recomendado por OWASP para aplicaciones web)
BCRYPT_COST=12

# Forzar cookie Secure (Solo true en produccion con HTTPS)
COOKIE_SECURE=false

# Lista de origenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000

# Activar solo si detras de un proxy inverso que establece X-Forwarded-For
TRUST_PROXY=false
